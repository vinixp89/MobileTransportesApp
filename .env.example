# URL base da API .NET (TransportesApp) — precisa ser acessível a partir do celular/emulador,
# então "localhost" só funciona no emulador Android (o Android mapeia 10.0.2.2 pro host); num
# celular físico use o IP da sua máquina na rede local (ex: http://192.168.0.10:5000/api).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
